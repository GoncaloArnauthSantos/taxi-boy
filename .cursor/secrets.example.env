# GitHub credentials for agent PR workflow (template — safe to commit)
# Copy to local secrets file (gitignored):
#   cp .cursor/secrets.example.env .cursor/secrets.env

# Personal Access Token or fine-grained token with repo + pull_request access
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional: for GitHub Enterprise
# GH_HOST=github.example.com

# Optional: default repo (owner/name) if gh cannot infer from remote
# GH_REPO=your-org/taxi-boy
