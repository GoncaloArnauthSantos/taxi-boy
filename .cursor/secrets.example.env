# GitHub credentials for agent PR workflow (local only — never commit)
# Setup:
#   mkdir -p .cursor/secrets
#   cp .cursor/secrets.example.env .cursor/secrets/github.env
# `.cursor/secrets/` is gitignored.

# Personal Access Token or fine-grained token with repo + pull_request access
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional: for GitHub Enterprise
# GH_HOST=github.example.com

# Optional: default repo (owner/name) if gh cannot infer from remote
# GH_REPO=your-org/taxi-boy
